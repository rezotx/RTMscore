FROM --platform=linux/amd64 python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Torch 2.2.1 CPU
RUN pip install --no-cache-dir \
    'torch==2.2.1' \
    --index-url https://download.pytorch.org/whl/cpu

# DGL 2.x from DGL's own wheel repo (matched to torch 2.2 CPU)
RUN pip install --no-cache-dir \
    dgl \
    -f https://data.dgl.ai/wheels/torch-2.2/repo.html

# DGL transitive deps
RUN pip install --no-cache-dir 'pyyaml' 'pydantic>=2.0' 'torchdata>=0.7,<0.8'

# Core scientific deps
RUN pip install --no-cache-dir \
    'numpy>=1.26,<2' \
    'pandas>=2.0' \
    'scipy>=1.11' \
    'scikit-learn>=1.3' \
    'rdkit>=2024.3' \
    'MDAnalysis>=2.6' \
    'prody>=2.4' \
    'joblib>=1.3' \
    'openbabel-wheel' \
    pytest

COPY . /app

ENV PYTHONPATH=/app
CMD ["pytest", "tests/", "-v", "--tb=short"]
